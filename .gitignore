# .gitignore

# Virtual environment & credentials
.venv/
.env

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Generated data (can be regenerated with scripts/generate_data.py)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
